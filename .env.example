# Session Secret - GENERA UNA CHIAVE UNICA CON: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-unique-secret-key-here

# Database (opzionale - SQLite usato di default)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Stripe - Chiave segreta per pagamenti (opzionale per sviluppo)
# STRIPE_SECRET_KEY=sk_test_xxx

# VAPID Keys per Push Notifications (opzionale)
# VAPID_PUBLIC=your-vapid-public-key
# VAPID_PRIVATE=your-vapid-private-key

# Node environment
# NODE_ENV=production
